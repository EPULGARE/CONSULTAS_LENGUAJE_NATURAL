APP_NAME=Text2SQL Secure Backend
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

METADATA_PATH=metadata
AUDIT_LOG_PATH=logs/audit.log

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL_SQL=google/gemini-2.5-flash
OPENROUTER_MODEL_CLASSIFIER=google/gemini-2.5-flash
OPENROUTER_PROXY_ENABLED=false
OPENROUTER_PROXY_HOST=
OPENROUTER_PROXY_PORT=8080
OPENROUTER_PROXY_USER=
OPENROUTER_PROXY_PASSWORD=
OPENROUTER_CA_CERT_PATH=
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_INSECURE=false

DB_DIALECT=oracle
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE_NAME=ORCLPDB1
DB_USER=readonly_user
DB_PASSWORD=change_me
DB_TIMEOUT_SECONDS=30
# 0 desactiva el limite automatico de filas.
DB_MAX_ROWS=0
DB_READ_ONLY=true

# Opcional: usar SID en lugar de SERVICE_NAME
DB_SID=

SQL_ALLOW_UNION=false
SQL_ALLOW_SELECT_WITHOUT_FROM=false
CATALOG_REQUIRE_APPROVAL=true
QUERY_DRY_RUN_DEFAULT=true
QUERY_ALLOW_EXECUTION=false
QUERY_INCLUDE_LLM_PROMPT_IN_DEBUG=false
